#!/usr/bin/env bash
set -euo pipefail

# Run the Demucs storage CLI from the normal ChordFlask environment. Demucs
# itself is resolved and executed from its separate optional environment.
#
# This script may be copied or symlinked to an arbitrary location; the
# repository root is read from the venv marker file, never inferred from
# this script's own location.

DEFAULT_VENV_DIR="${HOME}/.venvs/chordflask"
LEGACY_VENV_DIR="${HOME}/.venvs/chordifier"
VENV_DIR="${CHORDFLASK_VENV:-${CHORDIFIER_VENV:-${DEFAULT_VENV_DIR}}}"
if [[ -z "${CHORDFLASK_VENV:-}${CHORDIFIER_VENV:-}" \
    && ! -d "$VENV_DIR" && -d "$LEGACY_VENV_DIR" ]]; then
    VENV_DIR="$LEGACY_VENV_DIR"
fi
PYTHON_BIN="${CHORDFLASK_PYTHON:-${VENV_DIR}/bin/python}"

if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "Project virtual environment not found: ${VENV_DIR}" >&2
    echo "Create it with 'make setup' in the ChordFlask repository." >&2
    exit 1
fi

ROOT_FILE="${VENV_DIR}/.chordflask-root"
if [[ ! -f "${ROOT_FILE}" ]]; then
    echo "ChordFlask repository root marker not found: ${ROOT_FILE}" >&2
    echo "Create it with 'make setup' in the ChordFlask repository." >&2
    exit 1
fi

ROOT_DIR="$(cat "${ROOT_FILE}")"
if [[ ! -f "${ROOT_DIR}/chordflask_demucs/cli.py" ]]; then
    echo "ChordFlask repository root not found or invalid: ${ROOT_DIR}" >&2
    echo "The checkout may have moved; rerun 'make setup'." >&2
    exit 1
fi

export PYTHONPATH="${ROOT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON_BIN}" -m chordflask_demucs.cli "$@"
